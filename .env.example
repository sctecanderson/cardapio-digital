# Configuração do Supabase para o Frontend do Elozi
# Obtenha estas informações em: Supabase Dashboard -> Project Settings -> API

# URL do projeto Supabase (ex.: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública/anônima (anon / publishable key)
# NUNCA informe a service_role key aqui
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-anon-publica
